{
  "sources": [
    {
      "name": "Google Sheets",
      "dockerRepository": "ghcr.io/synclet-io/synclet/source-google-sheets",
      "dockerImageTag": "0.2.1",
      "documentationUrl": "",
      "releaseStage": "alpha",
      "supportLevel": "community",
      "sourceType": "api",
      "iconUrl": "",
      "license": "MIT",
      "spec": {
        "changeLogUrl": "",
        "connectionSpecification": {
          "description": "Reads data from a Google Sheets spreadsheet",
          "properties": {
            "batch_size": {
              "description": "Number of rows to fetch per batch request (default: 1000000)",
              "title": "Batch Size",
              "type": [
                "string"
              ]
            },
            "credentials": {
              "description": "Credentials for connecting to the Google Sheets API",
              "oneOf": [
                {
                  "properties": {
                    "auth_type": {
                      "const": "Client",
                      "type": [
                        "string"
                      ]
                    },
                    "client_id": {
                      "airbyte_secret": true,
                      "description": "Enter your Google application's Client ID",
                      "title": "Client ID",
                      "type": [
                        "string"
                      ]
                    },
                    "client_secret": {
                      "airbyte_secret": true,
                      "description": "Enter your Google application's Client Secret",
                      "title": "Client Secret",
                      "type": [
                        "string"
                      ]
                    },
                    "refresh_token": {
                      "airbyte_secret": true,
                      "description": "Enter your Google application's refresh token",
                      "title": "Refresh Token",
                      "type": [
                        "string"
                      ]
                    }
                  },
                  "required": [
                    "auth_type",
                    "client_id",
                    "client_secret",
                    "refresh_token"
                  ],
                  "title": "Authenticate via Google (OAuth)",
                  "type": [
                    "object"
                  ]
                },
                {
                  "properties": {
                    "auth_type": {
                      "const": "Service",
                      "type": [
                        "string"
                      ]
                    },
                    "service_account_info": {
                      "airbyte_secret": true,
                      "description": "The JSON key of the service account to use for authorization",
                      "title": "Service Account Information",
                      "type": [
                        "string"
                      ]
                    }
                  },
                  "required": [
                    "auth_type",
                    "service_account_info"
                  ],
                  "title": "Service Account Key Authentication",
                  "type": [
                    "object"
                  ]
                },
                {
                  "description": "Use Google Cloud Application Default Credentials (no extra fields needed)",
                  "properties": {
                    "auth_type": {
                      "const": "ApplicationDefault",
                      "type": [
                        "string"
                      ]
                    }
                  },
                  "required": [
                    "auth_type"
                  ],
                  "title": "Application Default Credentials",
                  "type": [
                    "object"
                  ]
                }
              ],
              "title": "Authentication",
              "type": [
                "object"
              ]
            },
            "names_conversion": {
              "description": "Convert column names to snake_case",
              "title": "Convert Column Names",
              "type": [
                "string"
              ]
            },
            "spreadsheet_id": {
              "description": "The ID or full URL of the Google Sheets spreadsheet",
              "title": "Spreadsheet Link",
              "type": [
                "string"
              ]
            }
          },
          "required": [
            "spreadsheet_id",
            "credentials"
          ],
          "title": "Google Sheets Source Spec",
          "type": "object"
        },
        "documentationUrl": "https://docs.google.com/spreadsheets",
        "supported_destination_sync_modes": [
          "overwrite",
          "append"
        ],
        "supportsDBT": false,
        "supportsIncremental": false,
        "supportsNormalization": false
      },
      "breakingChanges": {},
      "externalDocumentationUrls": [],
      "tombstone": false
    },
    {
      "dockerImageTag": "0.2.0",
      "dockerRepository": "ghcr.io/synclet-io/connectors/source-example",
      "documentationUrl": "https://github.com/synclet-io/connectors/tree/main/connectors/source-example",
      "language": "go",
      "license": "MIT",
      "name": "Example",
      "releaseStage": "alpha",
      "sourceType": "api",
      "supportLevel": "community",
      "tags": [
        "example"
      ],
      "tombstone": false,
      "spec": {
        "changelogUrl": "",
        "connectionSpecification": {
          "description": "Generates a sequence of numbered rows",
          "properties": {
            "count": {
              "default": 10,
              "description": "Number of rows to emit (1-1000000)",
              "order": 0,
              "title": "Row count",
              "type": "integer"
            }
          },
          "title": "Example Source Spec",
          "type": "object"
        },
        "documentationUrl": "https://github.com/synclet-io/connectors/tree/main/connectors/source-example",
        "protocol_version": "0.5.2",
        "supported_destination_sync_modes": [
          "overwrite",
          "append"
        ],
        "supportsDBT": false,
        "supportsIncremental": false,
        "supportsNormalization": false
      }
    },
    {
      "dockerImageTag": "0.2.0",
      "dockerRepository": "ghcr.io/synclet-io/connectors/source-postgres",
      "documentationUrl": "https://github.com/synclet-io/connectors/tree/main/connectors/source-postgres",
      "language": "go",
      "license": "MIT",
      "name": "Postgres",
      "releaseStage": "alpha",
      "sourceType": "database",
      "supportLevel": "community",
      "tags": [
        "database",
        "postgres"
      ],
      "tombstone": false,
      "spec": {
        "changelogUrl": "",
        "connectionSpecification": {
          "description": "Reads tables and views of a Postgres database: full refresh, or incremental by a cursor column.",
          "properties": {
            "database": {
              "description": "Name of the database.",
              "order": 2,
              "title": "Database Name",
              "type": "string"
            },
            "host": {
              "description": "Hostname of the database.",
              "order": 0,
              "title": "Host",
              "type": "string"
            },
            "password": {
              "airbyte_secret": true,
              "description": "Password associated with the username.",
              "order": 5,
              "title": "Password",
              "type": "string"
            },
            "port": {
              "default": 5432,
              "description": "Port of the database.",
              "examples": [
                "5432"
              ],
              "order": 1,
              "title": "Port",
              "type": "integer"
            },
            "schemas": {
              "default": [
                "public"
              ],
              "description": "The list of schemas to sync from.",
              "items": {
                "type": "string"
              },
              "order": 3,
              "title": "Schemas",
              "type": "array"
            },
            "ssl_mode": {
              "description": "How the connection is encrypted and which server certificates are trusted; the modes behave like libpq's sslmode.",
              "oneOf": [
                {
                  "description": "Disables encryption of communication between the connector and the source database.",
                  "properties": {
                    "mode": {
                      "const": "disable",
                      "order": 0,
                      "type": "string"
                    }
                  },
                  "required": [
                    "mode"
                  ],
                  "title": "disable",
                  "type": "object"
                },
                {
                  "description": "Connects without encryption, and with encryption when the server requires it.",
                  "properties": {
                    "mode": {
                      "const": "allow",
                      "order": 0,
                      "type": "string"
                    }
                  },
                  "required": [
                    "mode"
                  ],
                  "title": "allow",
                  "type": "object"
                },
                {
                  "description": "Connects with encryption when the server supports it, without otherwise.",
                  "properties": {
                    "mode": {
                      "const": "prefer",
                      "order": 0,
                      "type": "string"
                    }
                  },
                  "required": [
                    "mode"
                  ],
                  "title": "prefer",
                  "type": "object"
                },
                {
                  "description": "Always encrypts; the server certificate is not verified.",
                  "properties": {
                    "mode": {
                      "const": "require",
                      "order": 0,
                      "type": "string"
                    }
                  },
                  "required": [
                    "mode"
                  ],
                  "title": "require",
                  "type": "object"
                },
                {
                  "description": "Always encrypts and verifies that the server certificate is signed by the given CA.",
                  "properties": {
                    "ca_certificate": {
                      "airbyte_secret": true,
                      "description": "PEM certificate of the CA that signed the server certificate.",
                      "order": 1,
                      "title": "CA certificate",
                      "type": "string"
                    },
                    "client_certificate": {
                      "airbyte_secret": true,
                      "description": "PEM client certificate, when the server asks for one.",
                      "order": 2,
                      "title": "Client certificate",
                      "type": "string"
                    },
                    "client_key": {
                      "airbyte_secret": true,
                      "description": "PEM private key of the client certificate.",
                      "order": 3,
                      "title": "Client key",
                      "type": "string"
                    },
                    "mode": {
                      "const": "verify-ca",
                      "order": 0,
                      "type": "string"
                    }
                  },
                  "required": [
                    "mode",
                    "ca_certificate"
                  ],
                  "title": "verify-ca",
                  "type": "object"
                },
                {
                  "description": "Always encrypts and verifies the server certificate's CA and its hostname.",
                  "properties": {
                    "ca_certificate": {
                      "airbyte_secret": true,
                      "description": "PEM certificate of the CA that signed the server certificate.",
                      "order": 1,
                      "title": "CA certificate",
                      "type": "string"
                    },
                    "client_certificate": {
                      "airbyte_secret": true,
                      "description": "PEM client certificate, when the server asks for one.",
                      "order": 2,
                      "title": "Client certificate",
                      "type": "string"
                    },
                    "client_key": {
                      "airbyte_secret": true,
                      "description": "PEM private key of the client certificate.",
                      "order": 3,
                      "title": "Client key",
                      "type": "string"
                    },
                    "mode": {
                      "const": "verify-full",
                      "order": 0,
                      "type": "string"
                    }
                  },
                  "required": [
                    "mode",
                    "ca_certificate"
                  ],
                  "title": "verify-full",
                  "type": "object"
                }
              ],
              "order": 6,
              "title": "SSL Modes",
              "type": "object"
            },
            "tunnel_method": {
              "description": "Whether to initiate an SSH tunnel before connecting to the database, and if so, which kind of authentication to use.",
              "oneOf": [
                {
                  "properties": {
                    "tunnel_method": {
                      "const": "NO_TUNNEL",
                      "description": "No ssh tunnel needed to connect to database",
                      "order": 0,
                      "type": "string"
                    }
                  },
                  "required": [
                    "tunnel_method"
                  ],
                  "title": "No Tunnel",
                  "type": "object"
                },
                {
                  "properties": {
                    "ssh_key": {
                      "airbyte_secret": true,
                      "description": "OS-level user account ssh key credentials in PEM or OpenSSH format (RSA, ECDSA or Ed25519)",
                      "order": 4,
                      "title": "SSH Private Key",
                      "type": "string"
                    },
                    "tunnel_host": {
                      "description": "Hostname of the jump server host that allows inbound ssh tunnel.",
                      "order": 1,
                      "title": "SSH Tunnel Jump Server Host",
                      "type": "string"
                    },
                    "tunnel_host_key": {
                      "description": "Public host keys of the jump server, one per line, each in authorized_keys format (\"ssh-ed25519 AAAA...\") or as a known_hosts line (\"bastion.example.com ssh-ed25519 AAAA...\"); the whole output of ssh-keyscan works. The tunnel is refused when the server presents none of them. When empty, the host key is not verified.",
                      "order": 5,
                      "title": "SSH Host Key",
                      "type": "string"
                    },
                    "tunnel_method": {
                      "const": "SSH_KEY_AUTH",
                      "description": "Connect through a jump server tunnel host using username and ssh key",
                      "order": 0,
                      "type": "string"
                    },
                    "tunnel_port": {
                      "default": 22,
                      "description": "Port on the proxy/jump server that accepts inbound ssh connections.",
                      "examples": [
                        "22"
                      ],
                      "order": 2,
                      "title": "SSH Connection Port",
                      "type": "integer"
                    },
                    "tunnel_user": {
                      "description": "OS-level username for logging into the jump server host.",
                      "order": 3,
                      "title": "SSH Login Username",
                      "type": "string"
                    }
                  },
                  "required": [
                    "tunnel_method",
                    "tunnel_host",
                    "tunnel_port",
                    "tunnel_user",
                    "ssh_key"
                  ],
                  "title": "SSH Key Authentication",
                  "type": "object"
                },
                {
                  "properties": {
                    "tunnel_host": {
                      "description": "Hostname of the jump server host that allows inbound ssh tunnel.",
                      "order": 1,
                      "title": "SSH Tunnel Jump Server Host",
                      "type": "string"
                    },
                    "tunnel_host_key": {
                      "description": "Public host keys of the jump server, one per line, each in authorized_keys format (\"ssh-ed25519 AAAA...\") or as a known_hosts line (\"bastion.example.com ssh-ed25519 AAAA...\"); the whole output of ssh-keyscan works. The tunnel is refused when the server presents none of them. When empty, the host key is not verified.",
                      "order": 5,
                      "title": "SSH Host Key",
                      "type": "string"
                    },
                    "tunnel_method": {
                      "const": "SSH_PASSWORD_AUTH",
                      "description": "Connect through a jump server tunnel host using username and password authentication",
                      "order": 0,
                      "type": "string"
                    },
                    "tunnel_port": {
                      "default": 22,
                      "description": "Port on the proxy/jump server that accepts inbound ssh connections.",
                      "examples": [
                        "22"
                      ],
                      "order": 2,
                      "title": "SSH Connection Port",
                      "type": "integer"
                    },
                    "tunnel_user": {
                      "description": "OS-level username for logging into the jump server host.",
                      "order": 3,
                      "title": "SSH Login Username",
                      "type": "string"
                    },
                    "tunnel_user_password": {
                      "airbyte_secret": true,
                      "description": "OS-level password for logging into the jump server host",
                      "order": 4,
                      "title": "Password",
                      "type": "string"
                    }
                  },
                  "required": [
                    "tunnel_method",
                    "tunnel_host",
                    "tunnel_port",
                    "tunnel_user",
                    "tunnel_user_password"
                  ],
                  "title": "Password Authentication",
                  "type": "object"
                }
              ],
              "order": 7,
              "title": "SSH Tunnel Method",
              "type": "object"
            },
            "username": {
              "description": "Username to access the database.",
              "order": 4,
              "title": "Username",
              "type": "string"
            }
          },
          "required": [
            "host",
            "port",
            "database",
            "username"
          ],
          "title": "Postgres Source Spec",
          "type": "object"
        },
        "documentationUrl": "https://github.com/synclet-io/connectors/tree/main/connectors/source-postgres",
        "protocol_version": "0.5.2",
        "supported_destination_sync_modes": [
          "overwrite",
          "append",
          "append_dedup"
        ],
        "supportsDBT": false,
        "supportsIncremental": true,
        "supportsNormalization": false
      }
    }
  ],
  "destinations": []
}
